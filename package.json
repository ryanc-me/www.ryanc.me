{
  "name": "www.ryanc.me",
  "version": "1.0.0",
  "description": "https://www.ryanc.me",
  "main": ".eleventy.js",
  "license": "MIT",
  "scripts": {
    "dev": "run-p dev:*",
    "start": "eleventy --serve",
    "build": "run-s clean build:assets build:site",
    "dev:assets": "env ELEVENTY_ENV=development webpack --mode production --config webpack.config.dev.js --watch",
    "dev:site": "env ELEVENTY_ENV=development eleventy --serve",
    "build:assets": "webpack --mode production --config webpack.config.prod.js",
    "build:site": "env ELEVENTY_ENV=production eleventy",
    "clean": "rm -rf ./dist/*"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^1.0.9",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@tryghost/content-api": "^1.4.4",
    "@tryghost/helpers": "^1.1.6",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "clean-css": "^4.2.1",
    "cross-env": "^7.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "dotenv": "^8.0.0",
    "eleventy-plugin-lazyimages": "liamfiddler/eleventy-plugin-lazyimages",
    "eleventy-plugin-local-images": "^0.4.0",
    "eleventy-plugin-reading-time": "^0.0.1",
    "eslint-utils": "3.0.0",
    "ghost-storage-adapter-b2": "^1.0.0",
    "html-minifier": "^4.0.0",
    "jsdom": "^27.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-run-all": "^4.1.5",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "postcss": "^8.4.45",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.0.2",
    "prismjs": "^1.30.0",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-manifest-plugin": "^5.0.0",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "eslint": "7.32.0",
    "eslint-plugin-ghost": "2.11.0"
  }
