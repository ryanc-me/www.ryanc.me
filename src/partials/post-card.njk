{% from "tag-flag.njk" import tag_flag %}

{% macro post_card(post) %}
    <a class="--post-card" href="{{ post.url }}">
        <div class="date">
            {{ post.published_at | readableDate }}
        </div>
        <div class="separator left"></div>
        <h2 class="title">
            {{ post.title }}
        </h2>
        <div class="separator right"></div>
        {% if post.tags %}
            <div class="tags">
                {{ tag_flag(post.tags[0]) }}
            </div>
        {% endif %}
    </a>
{% endmacro %}
