---
pagination:
    data: collections.posts
    size: 1
    alias: post
    addAllPagesToCollections: true
permalink: '{{ post.url }}'
---
{% extends '../../layouts/base.njk' %}
{% from "tag-flag.njk" import tag_flag %}
{% from "utterances.njk" import utterances %}


{% set title = post.title %}
{% set description = post.excerpt %}
{% set feature_image = post.feature_image %}
{% set codeinjection_head = post.codeinjection_head %}
{% set codeinjection_foot = post.codeinjection_foot %}

{% block content %}
    <article class="--post-permalink">
        {% if post.feature_image %}
            <figure class="post-feature-image">
                <img src="{{ post.feature_image }}" alt="{{ title }}">
            </figure>
        {% endif %}
        <section class="post-full-content">
            <h1 class="content-title">{{ title }}</h1>
            <div class="meta">
                {% if post.tags %}
                    <span class="tags">
                        {%- for tag in post.tags -%}
                            {{ tag_flag(tag, true) }}
                        {%- endfor -%}
                    </span>
                {% endif %}
                <span class="date">{{ post.published_at | isoDate }}</span>
                <span class="read-time">{{ post.html | readingTime }}</span>
            </div>
            <section class="content-body load-external-scripts line-numbers">
                {{ post.html | safe if post.html else "Post content not found" }}
            </section>
        </section>
    </article>
    {# {{ utterances() }} #}
{% endblock %}
